# Keycloak PIM — Phase 0 configuration
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and must NEVER be committed.

# --- Keycloak target (ALL calls are scoped to this realm) ---
KC_BASE_URL="https://kc.staging.jadeuc.com"
KC_REALM="pim-test"

# --- Admin credentials for one-time setup (temporary; least privilege) ---
# The admin user used ONLY to create clients/roles/users during Phase 0 setup.
# This authenticates against the admin-cli client on the master realm by default.
KC_ADMIN_REALM="master"
KC_ADMIN_CLIENT_ID="admin-cli"
KC_ADMIN_USERNAME=""
KC_ADMIN_PASSWORD=""

# --- PIM service-account client (created by setup.sh) ---
# Least privilege: view-users, manage-users, view-realm, query-users, query-clients.
PIM_CLIENT_ID="pim-service"
PIM_CLIENT_SECRET=""   # populated by setup.sh after client creation

# --- Test fixtures (created by setup.sh) ---
# Passwords are intentionally weak for staging plumbing. NEVER use these in prod.
FIXTURE_PASSWORD="123456789"

TEST_ROLE="pim-test-role"              # safe custom role used for the plumbing proof

# Personas
LEAD_USERNAME="superadmin1"            # eligible (legacy name kept)
LEAD_PASSWORD="${FIXTURE_PASSWORD}"
ADMIN_USERNAME="admin1"                # eligible; elevated via admin-active on approve
ADMIN_PASSWORD="${FIXTURE_PASSWORD}"
ADMIN2_USERNAME="admin2"               # second eligible user
ADMIN2_PASSWORD="${FIXTURE_PASSWORD}"
PERMANENT_USERNAME="permanent1"        # only approvers (admin-permanent)
PERMANENT_PASSWORD="${FIXTURE_PASSWORD}"
BREAKGLASS_USERNAME="breakglass1"      # emergency permanent admin
BREAKGLASS_PASSWORD="${FIXTURE_PASSWORD}"

# Groups (created by setup.sh)
GROUP_BREAKGLASS="break-glass"           # -> realm-admin (emergency)
GROUP_ADMIN_ACTIVE="admin-active"        # JIT elevation target -> realm-admin (no standing members)
GROUP_ADMIN_ELIGIBLE="admin-eligible"    # can request
GROUP_ADMIN_PERMANENT="admin-permanent"  # approvers -> realm-admin standing
